# Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: server-only override for app/api/rpc/route.ts (the proxy the
# frontend actually talks to — see lib/constants.ts). Falls back to
# NEXT_PUBLIC_ARC_RPC_URL above if unset.
ARC_RPC_URL=

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=
NEXT_PUBLIC_P2P_ESCROW_ADDRESS=

# Circle CCTP TokenMessenger on Arc Testnet (domain 26) — override only if Circle redeploys it
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle Programmable Wallets
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Backend base URL (Reloadly webhooks / uploads), used by Top Up + Profile screens
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
