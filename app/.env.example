# Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: server-only override for app/api/rpc/route.ts (the proxy the
# frontend actually talks to — see lib/constants.ts). Falls back to
# NEXT_PUBLIC_ARC_RPC_URL above if unset.
ARC_RPC_URL=

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=
NEXT_PUBLIC_P2P_ESCROW_ADDRESS=

# Circle CCTP TokenMessenger on Arc Testnet (domain 26) — override only if Circle redeploys it
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA

# CCTP cross-chain send (hooks/useSend.ts's useCctpSend) — Circle's
# Forwarding Service is tried first (Circle mints on the destination
# automatically); the fields below are ONLY needed for the fallback path,
# when Iris has no fee quote for a given source/destination pair yet (seen
# for Arc, domain 26) and we fall back to a plain burn that needs our own
# server-side relay (app/api/cctp/relay/route.ts).
#
# Safe to leave all of these blank: the Forwarding Service path doesn't
# need any of them, and the fallback relay route just reports
# "not_configured" for whichever destination chain is missing its config,
# rather than silently failing.
#
#   NEXT_PUBLIC_IRIS_API_URL — Circle's CCTP v2 API. Defaults to
#     https://iris-api-sandbox.circle.com (sandbox); use
#     https://iris-api.circle.com for mainnet.
#   CCTP_RELAYER_PRIVATE_KEY — server-only EOA private key that submits
#     receiveMessage() on the destination chain for the fallback path.
#     Needs a small amount of that chain's native gas token. NEVER expose
#     this client-side.
#   {CHAIN}_RPC_URL / {CHAIN}_MESSAGE_TRANSMITTER_ADDRESS — per
#     destination chain. Addresses are Circle's own official CCTP
#     MessageTransmitter deployments for each testnet — verify against
#     Circle's current contract-address docs before setting these, since
#     this file doesn't hardcode a guess for any of them.
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_MESSAGE_TRANSMITTER_ADDRESS=
AVALANCHE_FUJI_RPC_URL=
AVALANCHE_FUJI_MESSAGE_TRANSMITTER_ADDRESS=
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_MESSAGE_TRANSMITTER_ADDRESS=
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_MESSAGE_TRANSMITTER_ADDRESS=
CCTP_RELAYER_PRIVATE_KEY=
NEXT_PUBLIC_IRIS_API_URL=

# SendWithFee (contracts/src/SendWithFee.sol) — collapses Send's fee-on flow
# into a single atomic transaction/confirmation. Safe to leave blank: Send
# falls back to the previous two-separate-transfers behavior until this is
# set. Deploy with:
#   cd contracts && forge script script/DeploySendWithFee.s.sol:DeploySendWithFee \
#     --rpc-url arc_testnet --broadcast --verify -vvvv
# then paste the logged "SendWithFee deployed:" address below.
NEXT_PUBLIC_SEND_WITH_FEE_ADDRESS=

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle Programmable Wallets
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Google social login via Circle Programmable Wallets (lib/circle.ts's
# loginWithGoogle). Safe to leave blank — the "Continue with Google" button
# fails gracefully with a clear message if unset, same as how email login
# already handles a missing CIRCLE_API_KEY. Requires:
#   1. A Google Cloud Console OAuth 2.0 Client ID (OAuth consent screen +
#      "Web application" credential type) — https://console.cloud.google.com/apis/credentials
#   2. That Client ID registered in Circle's Developer Console under your
#      Programmable Wallets app's social login settings — Circle needs to
#      know about it independently of Google Cloud Console.
#   3. NEXT_PUBLIC_GOOGLE_REDIRECT_URI added as an authorized redirect URI
#      in the SAME Google Cloud Console credential — must match exactly
#      (including trailing slash/no trailing slash) or Google will reject
#      the OAuth request.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional — defaults to the app's own origin (window.location.origin) at
# runtime if left blank, so this only needs setting if you want a fixed
# value regardless of deployment URL (e.g. always redirect to production
# even when testing against a preview deploy).
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# Backend base URL (Reloadly webhooks / uploads), used by Top Up + Profile screens
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Supabase (foundation only — no features wired up yet). Safe to leave
# blank: lib/supabase.ts falls back to a null client and nothing in the
# app currently reads from it. Get these from your Supabase project
# Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (server-only — bypasses RLS). NEVER expose to
# the client / prefix with NEXT_PUBLIC_. Safe to leave blank:
# lib/supabase-admin.ts returns null when unset. Get it from Supabase
# dashboard -> Settings -> API -> service_role key ("secret" — keep out of
# git, client bundles, and logs).
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared secret for POST /api/admin/index-sync (the manually-
# triggered indexer foundation stub — see app/api/admin/index-sync/route.ts
# and the SQL migration for p2p_offers/p2p_trades/p2p_disputes/
# p2p_merchant_applications). Safe to leave blank: the route skips the
# check entirely when unset, since the data it writes is all public
# on-chain data anyway — this only guards against wasted RPC calls from
# being spammed, not a data-integrity or privacy concern.
INDEXER_SYNC_SECRET=

# Merchant-application log-scan window (app/api/admin/index-sync +
# lib/indexer-chain-reader.ts). Arc's public testnet RPC prunes history, so
# scanning MerchantApplied from block 0 fails outright ("pruned history
# unavailable") — both safe to leave blank:
#   INDEXER_FROM_BLOCK — absolute starting block (e.g. P2PEscrow's real
#     deployment block, once known). ONLY consulted the very first time a
#     given event scan runs (no indexer_cursor row yet for it) — if unset,
#     that first run instead starts from (current block - 50000). Every
#     run after the first reads from its own persisted cursor
#     (indexer_cursor table — see supabase/indexer_cursor.sql) and ignores
#     this var entirely, so changing it later has no effect on an
#     already-running scan.
#   INDEXER_LOG_SCAN_BLOCKS — max blocks per eth_getLogs request. Defaults
#     to 100 if left blank — Arc's public RPC rejected both a 2000-block
#     window and any request combining multiple event signatures into one
#     filter, so every log scan does one event signature per request,
#     chunked at this size. A 400ms pause is added between every request
#     (successful or not) to avoid tripping Arc's rate limiter in the first
#     place; a rate-limit response (429 / -32005 / "rate limit") waits 2s
#     and retries that same window once before giving up on it for this
#     run, and a range/timeout-shaped error instead halves the window and
#     retries the same starting block — never skipping a window outright.
#     Either way, a window that ultimately still fails stops that event's
#     scan for this run without advancing its cursor, so the next run
#     retries the same window first rather than leaving a gap.
INDEXER_FROM_BLOCK=
INDEXER_LOG_SCAN_BLOCKS=

# Circle StableFX backend — /api/stablefx/* routes and lib/stablefx.ts
# still exist but are no longer mounted to any UI (the Swap tab is now
# App Kit only, see below). Safe to leave blank.
#   STABLEFX_API_KEY — server-only, never exposed to the client.
#   STABLEFX_API_BASE_URL — defaults to Circle's sandbox
#     (https://api-sandbox.circle.com); set to https://api.circle.com for live.
#   NEXT_PUBLIC_FX_ESCROW_ADDRESS — Circle's FxEscrow contract on Arc
#     Testnet (PvP settlement target for the Permit2 signature) — this is
#     NOT a contract we deploy.
#   NEXT_PUBLIC_PERMIT2_ADDRESS — Uniswap Permit2 on Arc Testnet, once
#     confirmed deployed there.
STABLEFX_API_KEY=
STABLEFX_API_BASE_URL=
NEXT_PUBLIC_FX_ESCROW_ADDRESS=
NEXT_PUBLIC_PERMIT2_ADDRESS=

# Circle App Kit Swap (https://docs.arc.network/app-kit/swap) — the only
# Swap UI on the Transfer page. USDC/EURC/cirBTC only, Arc Testnet, no
# cross-chain this pass. StableFX's swap UI has been removed entirely;
# lib/stablefx.ts and /api/stablefx/* still exist but are unmounted.
#
# WalletConnect/injected wallets quote and execute client-side against
# their own EIP-1193 provider — keyless in the browser on purpose (Circle's
# docs describe an API key for Swap as optional; the SDK throws if one is
# passed client-side).
#
# Circle Digital Wallets (email/Google) run server-side via
# @circle-fin/adapter-circle-wallets/ucw/server (app/api/swap/estimate,
# app/api/swap/execute) and reuse CIRCLE_API_KEY above — no separate key
# needed. Does NOT use CIRCLE_KIT_KEY: Circle's current Swap docs say kit
# keys are legacy ("new ones cannot be created... rename kitKey to apiKey
# when you upgrade the SDK").
