# Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: server-only override for app/api/rpc/route.ts (the proxy the
# frontend actually talks to — see lib/constants.ts). Falls back to
# NEXT_PUBLIC_ARC_RPC_URL above if unset.
ARC_RPC_URL=

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=
NEXT_PUBLIC_P2P_ESCROW_ADDRESS=

# Circle CCTP TokenMessenger on Arc Testnet (domain 26) — override only if Circle redeploys it
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA

# SendWithFee (contracts/src/SendWithFee.sol) — collapses Send's fee-on flow
# into a single atomic transaction/confirmation. Safe to leave blank: Send
# falls back to the previous two-separate-transfers behavior until this is
# set. Deploy with:
#   cd contracts && forge script script/DeploySendWithFee.s.sol:DeploySendWithFee \
#     --rpc-url arc_testnet --broadcast --verify -vvvv
# then paste the logged "SendWithFee deployed:" address below.
NEXT_PUBLIC_SEND_WITH_FEE_ADDRESS=

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle Programmable Wallets
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Google social login via Circle Programmable Wallets (lib/circle.ts's
# loginWithGoogle). Safe to leave blank — the "Continue with Google" button
# fails gracefully with a clear message if unset, same as how email login
# already handles a missing CIRCLE_API_KEY. Requires:
#   1. A Google Cloud Console OAuth 2.0 Client ID (OAuth consent screen +
#      "Web application" credential type) — https://console.cloud.google.com/apis/credentials
#   2. That Client ID registered in Circle's Developer Console under your
#      Programmable Wallets app's social login settings — Circle needs to
#      know about it independently of Google Cloud Console.
#   3. NEXT_PUBLIC_GOOGLE_REDIRECT_URI added as an authorized redirect URI
#      in the SAME Google Cloud Console credential — must match exactly
#      (including trailing slash/no trailing slash) or Google will reject
#      the OAuth request.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional — defaults to the app's own origin (window.location.origin) at
# runtime if left blank, so this only needs setting if you want a fixed
# value regardless of deployment URL (e.g. always redirect to production
# even when testing against a preview deploy).
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# Backend base URL (Reloadly webhooks / uploads), used by Top Up + Profile screens
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Supabase (foundation only — no features wired up yet). Safe to leave
# blank: lib/supabase.ts falls back to a null client and nothing in the
# app currently reads from it. Get these from your Supabase project
# Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (server-only — bypasses RLS). NEVER expose to
# the client / prefix with NEXT_PUBLIC_. Safe to leave blank:
# lib/supabase-admin.ts returns null when unset. Get it from Supabase
# dashboard -> Settings -> API -> service_role key ("secret" — keep out of
# git, client bundles, and logs).
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared secret for POST /api/admin/index-sync (the manually-
# triggered indexer foundation stub — see app/api/admin/index-sync/route.ts
# and the SQL migration for p2p_offers/p2p_trades/p2p_disputes/
# p2p_merchant_applications). Safe to leave blank: the route skips the
# check entirely when unset, since the data it writes is all public
# on-chain data anyway — this only guards against wasted RPC calls from
# being spammed, not a data-integrity or privacy concern.
INDEXER_SYNC_SECRET=

# Merchant-application log-scan window (app/api/admin/index-sync +
# lib/indexer-chain-reader.ts). Arc's public testnet RPC prunes history, so
# scanning MerchantApplied from block 0 fails outright ("pruned history
# unavailable") — both safe to leave blank:
#   INDEXER_FROM_BLOCK — absolute starting block (e.g. P2PEscrow's real
#     deployment block, once known). Takes priority over the window below.
#   INDEXER_LOG_SCAN_BLOCKS — rolling window size in blocks, scanned back
#     from the current block, when INDEXER_FROM_BLOCK isn't set. Defaults
#     to 50000 if left blank.
INDEXER_FROM_BLOCK=
INDEXER_LOG_SCAN_BLOCKS=

# Circle StableFX — Transfer page's Swap tab (USDC<->EURC, v1). Safe to
# leave blank: GET /api/stablefx/status reports "not configured" and the
# Swap tab renders disabled with explanatory copy — no placeholder rate,
# no fallback execution path.
#   STABLEFX_API_KEY — server-only, never exposed to the client.
#   STABLEFX_API_BASE_URL — defaults to Circle's sandbox
#     (https://api-sandbox.circle.com); set to https://api.circle.com for live.
#   NEXT_PUBLIC_FX_ESCROW_ADDRESS — Circle's FxEscrow contract on Arc
#     Testnet (PvP settlement target for the Permit2 signature) — this is
#     NOT a contract we deploy.
#   NEXT_PUBLIC_PERMIT2_ADDRESS — Uniswap Permit2 on Arc Testnet, once
#     confirmed deployed there.
STABLEFX_API_KEY=
STABLEFX_API_BASE_URL=
NEXT_PUBLIC_FX_ESCROW_ADDRESS=
NEXT_PUBLIC_PERMIT2_ADDRESS=
