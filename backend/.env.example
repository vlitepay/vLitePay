PORT=4000
CORS_ORIGIN=http://localhost:3000

# Arc Testnet — used by src/lib/chain.ts to verify top-up payments on-chain via viem
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# P2PEscrow contract address — its treasury() getter is read on-chain to find the payout address.
P2P_ESCROW_ADDRESS=
# Optional: skip the on-chain treasury() read and use this address directly instead.
TREASURY_ADDRESS=

# Reloadly sandbox credentials — https://www.reloadly.com/ (enable Sandbox mode in the dashboard)
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_AUDIENCE=https://topups-sandbox.reloadly.com
RELOADLY_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token

# Shared secret to verify inbound Reloadly webhook signatures (set the same value in the Reloadly dashboard)
RELOADLY_WEBHOOK_SECRET=

# Google Cloud Vision OCR — powers the admin dispute-review receipt analyzer
# (src/routes/receipts.ts). Enable the "Cloud Vision API" on a Google Cloud
# project, then create an API key (APIs & Services > Credentials) and
# restrict it to the Cloud Vision API. The free tier covers a monthly quota
# of requests — check current limits at https://cloud.google.com/vision/pricing.
GOOGLE_CLOUD_VISION_API_KEY=

# Local upload storage (swap for an IPFS pinning service, e.g. web3.storage, in production)
UPLOAD_DIR=./uploads

# Email notifications (placeholder — see src/routes/notifications.ts)
# Set EMAIL_PROVIDER to "resend" or "sendgrid" and the matching API key to enable real sending.
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=notifications@vlitepay.app
